# Postgres connection URL. Leave unset for local dev / zero-setup deployments — the server will
# automatically download, initialize, and start an embedded Postgres instance under .pgdata/
# instead (same Diesel migrations run either way).
# For the RoboticsWest-operated container deploy (deploy/timekeeper/), DATABASE_URL is required
# and points at an externally-managed Postgres container conventionally named `timekeeper-db`.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/timekeeper

# Admin password (if unset, uses the existing password in the DB, or "admin" on first run).
# TK_ADMIN_PASSWORD=

# TMS Mobi Reverse Proxy Token
# TK_PROXY_TOKEN=

# TMS Mobi Reverse Proxy Sub-Domain
# TK_PROXY_DOMAIN=
